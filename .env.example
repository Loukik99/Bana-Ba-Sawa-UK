# Local development works with these defaults. Copy to `.env` only if you
# need to override them.

PORT=3001
DATABASE_PATH=./data/bana-ba-sawa.db

# Public website URL used in password-reset emails.
# APP_URL=http://localhost:5173

# Required when the API and website are served from different origins.
# CLIENT_ORIGIN=http://localhost:5173

# Optional SMTP settings. Without them, reset emails are printed to the
# API console and saved to data/last-reset-email.json in development.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Bana Ba Sawa UK <noreply@example.org>
# RESET_TOKEN_TTL_MINUTES=60

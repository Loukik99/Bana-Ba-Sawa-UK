# Local development works with SQLite defaults. Copy this file to `.env`
# only if you need to override them. Never commit `.env` files.

PORT=3001
DATABASE_PATH=./data/bana-ba-sawa.db

# Public website URL used in password-reset emails.
# Required in production. Must be the live website, not localhost.
# APP_URL=http://localhost:5173

# Required when the API and website are served from different origins.
# Not needed when the frontend and API share the same Vercel domain.
# CLIENT_ORIGIN=http://localhost:5173

# Production PostgreSQL connection string.
# Required in production. Use the pooled URL from your host (Neon recommended).
# DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require

# Optional SMTP settings. Without them, development writes a local preview
# to the API console and data/last-reset-email.json. That preview never runs
# in production or on Vercel. In production, forgot-password still reaches
# the API, but emails are not sent until SMTP is configured.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Bana Ba Sawa UK <noreply@example.org>
# RESET_TOKEN_TTL_MINUTES=60
# VERIFY_TOKEN_TTL_HOURS=24
